# Supabase config — replace these with the values from your own project.
# Find them in the Supabase dashboard under Settings > API.
# Vite only exposes variables that start with VITE_ to your app.
# Restart `npm run dev` after changing this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
