# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# Project URL:     Project Settings > Data API
# Publishable key: Project Settings > API Keys (starts with sb_publishable_)
#
# Vite only exposes variables that start with VITE_ to your app.
# Restart `npm run dev` after changing .env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
